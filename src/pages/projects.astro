---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { archivedProjects, moreProjects, topProjects } from "../data/projects";
---

<Base title="Projects" description="Side projects by Andrew Bishop: music tools, data visualization and web apps.">
  <h1>Projects</h1>
  <p>Small things I've built to learn new tools. The source for all of them is on GitHub.</p>

  <ul class="project-grid top">
    {topProjects.map((project) => <li><ProjectCard project={project} /></li>)}
  </ul>

  <h2>More projects</h2>
  <ul class="project-grid more">
    {moreProjects.map((project) => <li><ProjectCard project={project} /></li>)}
  </ul>

  <h2>Archive</h2>
  <ul class="archive-list">
    {
      archivedProjects.map((project) => (
        <li>
          <a href={project.repo}>{project.title}</a>
          <span class="desc">{project.description}</span>
        </li>
      ))
    }
  </ul>
</Base>
