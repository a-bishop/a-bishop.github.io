---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Base title="Projects" description="Side projects by Andrew Bishop: music tools, language learning, data visualization and web apps.">
  <h1 class="visually-hidden">Projects</h1>
  <p>Small things I've built to learn new tools.</p>

  <ul class="project-grid">
    {projects.map((project) => <li><ProjectCard project={project} /></li>)}
  </ul>
</Base>
