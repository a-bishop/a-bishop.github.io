---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { archivedProjects, projects } from "../data/projects";
---

<Base title="Projects" description="Side projects by Andrew Bishop: music tools, language learning, data visualization and web apps.">
  <h1 class="visually-hidden">Projects</h1>
  <p>Small things I've built to learn new tools.</p>

  <ul class="project-grid">
    {projects.map((project) => <li><ProjectCard project={project} /></li>)}
  </ul>

  <h2>Archive</h2>
  <ul class="archive-list">
    {
      archivedProjects.map((project) => (
        <li>
          <a href={project.repo}>{project.title}</a>
          <span class="desc">{project.description}</span>
        </li>
      ))
    }
  </ul>
</Base>
