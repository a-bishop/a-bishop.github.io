---
import PostMeta from "../components/PostMeta.astro";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { getPosts, type Post } from "../lib/posts";

// Posts live at the site root (e.g. /wrapping-mocha-tests-with-a-custom-retry-handler)
// to keep the URLs from the old Gatsby site.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, note } = post.data;
---

<Base title={title} description={description} type="article" publishedTime={date.toISOString()} section="/">
  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <PostMeta tags={tags} date={date} />
    </header>

    {note && <aside class="note">{note}</aside>}

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/">← All posts</a>
    </footer>
  </article>
</Base>
