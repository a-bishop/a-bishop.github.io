---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getTags, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { name: tag.name, posts: tag.posts } }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<Base title={name} description={`Posts tagged ${name}.`}>
  <div class="section-head" style="margin-top: 0">
    <h1 style="margin: 0">{name}</h1>
    <a href="/tags">View all tags</a>
  </div>
  <PostList posts={posts} />
</Base>
