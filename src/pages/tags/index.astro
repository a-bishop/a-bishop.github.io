---
import Base from "../../layouts/Base.astro";
import { getTags } from "../../lib/posts";

const tags = await getTags();
---

<Base title="Tags" description="Blog posts by topic.">
  <h1>Tags</h1>
  <ul class="tag-cloud">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.slug}/`}>
            {tag.name}
            <span class="count">{tag.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
