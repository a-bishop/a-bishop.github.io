---
import TagLinks from "./TagLinks.astro";
import { formatDate, isoDate, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  showTags?: boolean;
}

const { posts, showTags = true } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a class="post-link" href={`/${post.id}`}>
          {post.data.title}
        </a>
        <p class="post-meta">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {showTags && post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true"> — </span>
              <TagLinks tags={post.data.tags} />
            </>
          )}
        </p>
      </li>
    ))
  }
</ul>
