---
import TagLinks from "./TagLinks.astro";
import { formatDate, isoDate, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  /** Dates are hidden in lists for now; each post page still shows its date. */
  showDates?: boolean;
}

const { posts, showDates = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a class="post-link" href={`/${post.id}`}>
          {post.data.title}
        </a>
        {(showDates || post.data.tags.length > 0) && (
          <p class="post-meta">
            {showDates && <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>}
            {showDates && post.data.tags.length > 0 && <span aria-hidden="true"> — </span>}
            <TagLinks tags={post.data.tags} />
          </p>
        )}
      </li>
    ))
  }
</ul>
