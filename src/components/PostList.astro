---
import PostMeta from "./PostMeta.astro";
import type { Post } from "../lib/posts";

interface Props {
  posts: Post[];
  /** Dates are hidden in lists for now; each post page still shows its date. */
  showDates?: boolean;
}

const { posts, showDates = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a class="post-link" href={`/${post.id}/`}>
          {post.data.title}
        </a>
        <PostMeta tags={post.data.tags} date={showDates ? post.data.date : undefined} />
      </li>
    ))
  }
</ul>
