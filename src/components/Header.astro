---
import { NAV, SITE } from "../lib/site";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-top">
    <a class="site-title" href="/">{SITE.title}</a>
    <ThemeToggle />
  </div>
  <div class="header-bottom">
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="social-list">
      <li>
        <a href={SITE.github} rel="me" aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
      </li>
      <li>
        <a href={SITE.linkedin} rel="me" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
      </li>
    </ul>
  </div>
</header>
