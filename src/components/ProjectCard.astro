---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const primary = project.demo ?? project.repo;
---

<article class="project-card">
  <h3><a href={primary}>{project.title}</a></h3>
  <p>{project.description}</p>
  <ul class="project-tech" aria-label="Built with">
    {project.tech.map((t) => <li>{t}</li>)}
  </ul>
  <div class="project-links">
    {project.demo && <a href={project.demo}>Live demo</a>}
    <a href={project.repo}>Source on GitHub</a>
  </div>
</article>
