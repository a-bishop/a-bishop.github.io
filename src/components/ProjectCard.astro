---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const primary = project.demo ?? project.repo;
---

<article class="project-card">
  <div class="project-head">
    <h2><a href={primary}>{project.title}</a></h2>
    {project.inProgress && <span class="project-status">In progress</span>}
  </div>
  <p>{project.description}</p>
  <ul class="project-tech" aria-label="Built with">
    {project.tech.map((t) => <li>{t}</li>)}
  </ul>
  <div class="project-links">
    {project.demo && <a href={project.demo}>Live demo<span class="visually-hidden"> of {project.title}</span></a>}
    <a href={project.repo}>Source on GitHub<span class="visually-hidden"> for {project.title}</span></a>
  </div>
</article>
